# Optional local database override
CRYPTOPULSE_DATABASE_PATH=data/cryptopulse.db

# Required only for live OpenAI classification, not for viewing the dashboard
CRYPTOPULSE_OPENAI_API_KEY=replace-with-your-local-key
CRYPTOPULSE_OPENAI_MODEL=gpt-5.6-luna

# Optional operational settings
CRYPTOPULSE_LOG_LEVEL=INFO
CRYPTOPULSE_REQUEST_TIMEOUT_SECONDS=10
CRYPTOPULSE_GDELT_REQUEST_TIMEOUT_SECONDS=45
